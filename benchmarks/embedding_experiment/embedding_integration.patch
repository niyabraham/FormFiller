+def _mutual_best(cfg: Config, t: str, L: str, s: float, q_words: list[str], leaf_words: list[str]) -> bool:
+    """A provider link must be the clear best pairing for BOTH words: no other key word fits `t` nearly as well, and no other
+    question word fits `L` nearly as well. Two words that merely sit in the same neighbourhood are not aligned."""
+    assert cfg.provider is not None
+    rivals = [cfg.provider.similarity(t, x) for x in leaf_words if x != L] + [cfg.provider.similarity(y, L) for y in q_words if y != t]
+    return not rivals or s - max(rivals) >= cfg.provider_margin
+
