diff --git a/tools/evaluate_embedding.py b/tools/evaluate_embedding.py
new file mode 100644
index 0000000..cb1c250
--- /dev/null
+++ b/tools/evaluate_embedding.py
@@ -0,0 +1,79 @@
+"""Compare the baseline matcher with the embedding-enhanced matcher on the same fixed question sets (no browser).
+
+    python tools/evaluate_embedding.py --model /path/to/all-MiniLM-L6-v2 --splits dev seen --min 0.5 0.55 0.6   # choose a threshold
+    python tools/evaluate_embedding.py --model DIR --splits dev seen heldout heldout_v3 --min 0.6 --out-dir DIR  # report
+
+Pick the threshold on `dev` and `seen` ONLY. `heldout` (v2) and `heldout_v3` are evaluation sets: running them is fine, tuning on
+them is not. Every question goes through the shipped code path (understand_control -> index_source -> plan_question); the only
+difference between the two runs is `retrieve.SEMANTIC`. Embedding similarity can only change which words count as explained, so
+every other check is identical in both runs.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import replace
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from formfill.web import embedding, retrieve, semantic
+from formfill.web.retrieve import index_source
+from tools.evaluate_semantic import BENCH, digest, evaluate_question, summarise
+
+
+def run(split: str) -> list[dict]:
+    doc = json.loads((BENCH / f"{split}.json").read_text())
+    rows = []
+    for case in doc["cases"]:
+        leaves = index_source(case["source"])
+        for n, q in enumerate(case["questions"]):
+            r = evaluate_question(leaves, q, n)
+            r["case"] = case["id"]
+            rows.append(r)
+    return rows
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--splits", nargs="+", default=["dev", "seen"])
+    ap.add_argument("--min", nargs="+", type=float, default=[0.6], help="similarity thresholds to evaluate")
+    ap.add_argument("--out-dir")
+    args = ap.parse_args()
+    prov = embedding.EmbeddingProvider(args.model)
+    base_cfg = semantic.DEFAULT
+    report: dict = {"model_dir": args.model, "splits": {}}
+    for split in args.splits:
+        retrieve.SEMANTIC = base_cfg
+        base = run(split)
+        report["splits"][split] = {"digest": digest(BENCH / f"{split}.json"), "baseline": summarise(base), "embedding": {}}
+        b = summarise(base)
+        print(f"\n[{split}] baseline: answered={b['auto_answered']} correct={b['correct']} unsafe={b['unsafe']} "
+              f"precision={b['precision_pct']} coverage={b['coverage_pct']}")
+        for m in args.min:
+            prov.min_similarity = m
+            retrieve.SEMANTIC = replace(base_cfg, provider=prov, provider_min=m)
+            emb = run(split)
+            s = summarise(emb)
+            changed = [(x, y) for x, y in zip(base, emb) if x["outcome"] != y["outcome"] or x["got"] != y["got"]]
+            print(f"  min={m:.2f} embedding: answered={s['auto_answered']} correct={s['correct']} unsafe={s['unsafe']} "
+                  f"precision={s['precision_pct']} coverage={s['coverage_pct']}  changed={len(changed)}")
+            for x, y in changed:
+                print(f"      {x['outcome']:>14} -> {y['outcome']:<14} [{x['case']}] {x['question']!r}  got {y['got']}  {y['evidence']}"[:300])
+            report["splits"][split]["embedding"][str(m)] = {**s, "changed": [
+                {"question": x["question"], "case": x["case"], "expect": x["expect"], "before": x["outcome"], "after": y["outcome"],
+                 "got_before": x["got"], "got_after": y["got"], "evidence": y["evidence"]} for x, y in changed]}
+    if args.out_dir:
+        out = Path(args.out_dir)
+        out.mkdir(parents=True, exist_ok=True)
+        (out / "embedding_comparison.json").write_text(json.dumps(report, indent=1, default=str) + "\n")
+        print("\nwrote", out / "embedding_comparison.json")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
