+"""OPTIONAL local embedding signal for term alignment (all-MiniLM-L6-v2 through sentence-transformers).
+
+This is a `semantic.TermProvider`, nothing more. It can only say "this question word names the same thing as this key word"; the
+word is then counted as explained at a reduced weight, the link is written to the candidate's `evidence`, and every cap (scope,
+polarity, period, population, identifier, counting) and the ambiguity rule still run afterwards. Similarity never authorises an
+answer or a browser action by itself, and it is off unless a local model directory is configured:
+
+    FORMFILL_EMBEDDING_MODEL=/path/to/all-MiniLM-L6-v2     (or  python -m formfill fill ... --embedding-model DIR)
+
+Offline by construction: the model is loaded from that directory with `local_files_only=True`, the Hugging Face offline switches
+are set before the library is imported, and nothing is downloaded at run time. If the directory is incomplete or the optional
+packages (`pip install "formfill-poc[embeddings]"`) are missing, the provider is unavailable and the baseline matcher runs
+unchanged (one warning is emitted).
+
+Cost: importing torch + loading the model takes about a second on CPU and ~0.5 GB of RAM; a word is embedded once and cached.
+"""
+
+from __future__ import annotations
+
+import os
+import warnings
+from pathlib import Path
+
+from formfill.web.tokens import NEGATORS, NEUTRAL, QUALIFIERS, SELF_REFERENCE
+
+ENV_VAR = "FORMFILL_EMBEDDING_MODEL"
+REQUIRED_FILES = (
+    "config.json", "config_sentence_transformers.json", "modules.json", "sentence_bert_config.json", "special_tokens_map.json",
+    "tokenizer.json", "tokenizer_config.json", "vocab.txt", "1_Pooling/config.json", "model.safetensors",
+)
+# Words whose meaning is a *constraint* on the fact (scope, negation, period). A sentence-embedding model puts "previous" next to
+# "current" and "parent" next to "subsidiary"; those must never be treated as the same word.
+_NEVER_ALIGN = frozenset(QUALIFIERS | NEGATORS | NEUTRAL | SELF_REFERENCE | {
+    "year", "month", "quarter", "week", "day", "daily", "monthly", "weekly", "next", "last", "future", "past", "new", "old",
+    "total", "all", "any", "other", "more", "less", "first", "second", "third", "main", "head", "group", "uk", "us", "eu"})
+
+
+class EmbeddingUnavailable(RuntimeError):
+    pass
+
+
+def missing_files(model_dir: str | Path) -> list[str]:
+    root = Path(model_dir)
+    return [f for f in REQUIRED_FILES if not (root / f).is_file()]
+
+
+class EmbeddingProvider:
+    """Word-level cosine similarity from a locally stored sentence-transformers model."""
+
+    name = "embedding"
+
+    def __init__(self, model_dir: str | Path, min_similarity: float = 0.55) -> None:
+        gaps = missing_files(model_dir)
+        if gaps:
+            raise EmbeddingUnavailable(f"model directory {str(model_dir)!r} is incomplete (missing: {', '.join(gaps)})")
+        os.environ["HF_HUB_OFFLINE"] = "1"
+        os.environ["TRANSFORMERS_OFFLINE"] = "1"
+        try:
+            from sentence_transformers import SentenceTransformer
+        except ImportError as exc:
+            raise EmbeddingUnavailable('install the optional packages: pip install "formfill-poc[embeddings]"') from exc
+        try:
+            self._model = SentenceTransformer(str(model_dir), device="cpu", local_files_only=True)
+        except Exception as exc:  # noqa: BLE001 - any load failure means "unavailable", never a crash
+            raise EmbeddingUnavailable(f"could not load the model from {str(model_dir)!r}: {exc}") from exc
+        self.min_similarity = min_similarity
+        self._vec: dict[str, object] = {}
+
+    def _embed(self, word: str):
+        v = self._vec.get(word)
+        if v is None:
+            v = self._model.encode([word], normalize_embeddings=True, show_progress_bar=False)[0]
+            self._vec[word] = v
+        return v
+
+    def similarity(self, question_term: str, leaf_term: str) -> float:
+        a, b = question_term.lower(), leaf_term.lower()
+        for w in (a, b):
+            if len(w) < 4 or not w.isalpha() or w in _NEVER_ALIGN:
+                return 0.0
+        return float(self._embed(a) @ self._embed(b))  # type: ignore[operator]
+
+
+def provider_from_env() -> EmbeddingProvider | None:
+    path = os.environ.get(ENV_VAR)
+    if not path:
+        return None
+    try:
+        return EmbeddingProvider(path)
+    except EmbeddingUnavailable as exc:
+        warnings.warn(f"embedding matcher unavailable, using the baseline matcher: {exc}", stacklevel=2)
+        return None
