+++ b/tests/web/test_widgets_3d.py
@@ -0,0 +1,89 @@
+"""Phase 3D: widget commitment and verification against SurveyJS-compatible local fixtures (benchmarks/spa/fixtures/w3d_*).
+
+Three separate things are asserted and must not be conflated:
+  DOM read-back   what the page's own elements hold afterwards (what the pipeline can observe in any app)
+  app state       what the application recorded (window.__state; only measurable because these fixtures expose it)
+  discovery       whether a conditional question that depends on a commit appeared and was answered
+Generic local fixtures say nothing about the reliability of any real portal."""
+
+import json
+import time
+from pathlib import Path
+
+import pytest
+
+from formfill.web.pipeline import run_form
+from formfill.web.steps import DiscoveryPolicy
+
+pytestmark = pytest.mark.browser
+
+BENCH = Path(__file__).resolve().parents[2] / "benchmarks" / "spa"
+SOURCE = json.loads((BENCH / "source.json").read_text())
+
+import sys
+
+sys.path.insert(0, str(BENCH.parents[1]))
+from benchmarks.spa.server import serve
+
+
+@pytest.fixture(scope="module")
+def base():
+    with serve() as url:
+        yield url
+
+
+@pytest.fixture
+def run(page, base):
+    def _run(fid, policy=False, **kw):
+        page.goto(f"{base}/{fid}")
+        res = run_form(page, SOURCE, policy=DiscoveryPolicy() if policy else None, **kw)
+        return res, page.evaluate("() => window.__state || {}"), page
+
+    return _run
+
+
+def by_label(res, text):
+    return next(i for i in res.items if text.lower() in i.plan.question.lower())
+
+
+@pytest.mark.parametrize("policy", [False, True])
+def test_blur_commit_reaches_app_state_and_reveals_conditional(run, policy):
+    res, state, page = run("w3d_blur_commit.html", policy=policy)
+    assert state == {"name": "Acme Robotics Ltd", "email": "info@acme-robotics.example", "city": "Leeds"}  # app state
+    assert all(by_label(res, k).verified for k in ("company name", "email", "city"))  # DOM read-back
+    assert page.input_value("#city") == "Leeds"  # conditional field discovered and filled
+
+
+def test_blur_revert_is_not_reported_as_success(run):
+    res, state, _ = run("w3d_blur_commit.html?mode=revert")
+    item = by_label(res, "company name")
+    assert not item.verified and "name" not in state
+
+
+def test_readonly_combobox_option_is_picked_and_committed(run):
+    res, state, page = run("w3d_readonly_combobox.html")
+    item = by_label(res, "country")
+    assert item.filled and item.verified
+    assert state["country"] == "United Kingdom" and page.input_value("#country") == "United Kingdom"
+
+
+def test_unopenable_readonly_combobox_stops_fast_with_clear_reason(run):
+    t0 = time.monotonic()
+    res, state, _ = run("w3d_readonly_combobox.html?mode=dead", timeout_ms=5000)
+    item = by_label(res, "country")
+    assert not item.filled and "readonly" in item.detail.lower() and "unsupported" in item.detail.lower()
+    assert time.monotonic() - t0 < 4.5 and "country" not in state
+
+
+def test_styled_radio_selected_through_label_not_forced(run):
+    res, state, page = run("w3d_styled_radio.html", timeout_ms=3000)
+    item = by_label(res, "sector")
+    assert item.filled and item.verified
+    assert state["sector"] == "Manufacturing" and page.is_checked("#r1") and not page.is_checked("#r2")
+
+
+def test_ordinary_and_controlled_inputs_unchanged(page, base):
+    for fid in ("controlled", "cond_sync", "combobox"):
+        page.goto(f"{base}/{fid}.html")
+        res = run_form(page, SOURCE)
+        assert any(i.verified for i in res.items), fid
diff --git a/tools/evaluate_widgets3d.py b/tools/evaluate_widgets3d.py
new file mode 100644
index 0000000..d313079
--- /dev/null
+++ b/tools/evaluate_widgets3d.py
@@ -0,0 +1,97 @@
+"""Phase 3D widget evaluation on the local SurveyJS-compatible fixtures (benchmarks/spa/fixtures/w3d_*).
+
+    python tools/evaluate_widgets3d.py --out-dir benchmarks/spa/results/phase3d/after
+
+Four things are reported separately, per field, because they are different claims:
+  fill_ok       the pipeline's fill step reported no error
+  dom_readback  the pipeline's independent read of the page's own element matched the planned answer
+  app_state     the application's own record (window.__state, exposed by the fixture) holds the expected value.
+                Only measurable because the fixtures publish it; a real portal gives no such view.
+  discovered    a conditional question (one that exists only after an earlier answer is committed) was found and filled
+Generic local fixtures; this says nothing about the reliability of any real portal.
+Run against another checkout with FORMFILL_PIPELINE_ROOT=<path> (used for the 'before' run on a clean worktree).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(os.environ.get("FORMFILL_PIPELINE_ROOT", Path(__file__).resolve().parent.parent))
+sys.path.insert(0, str(ROOT))
+sys.path.append(str(Path(__file__).resolve().parent.parent))
+
+from playwright.sync_api import sync_playwright
+
+from benchmarks.spa.server import serve
+from formfill.web.pipeline import run_form
+
+BENCH = Path(__file__).resolve().parent.parent / "benchmarks" / "spa"
+LABEL = {"name": "company name", "email": "email", "city": "city", "country": "country", "sector": "sector"}
+
+
+def _git(*a):
+    return subprocess.run(["git", "-C", str(ROOT), *a], capture_output=True, text=True, check=False).stdout.strip()
+
+
+def sha(p: Path) -> str:
+    return hashlib.sha256(p.read_bytes()).hexdigest()
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out-dir", type=Path, required=True)
+    args = ap.parse_args()
+    gt = json.loads((BENCH / "ground_truth_3d.json").read_text())
+    source = json.loads((BENCH / "source.json").read_text())
+    rows = []
+    with serve() as base, sync_playwright() as p:
+        b = p.chromium.launch(executable_path=os.environ.get("FORMFILL_CHROMIUM") or None)
+        for fid, spec in gt.items():
+            ctx = b.new_context()
+            page = ctx.new_page()
+            page.set_default_timeout(4000)
+            page.goto(f"{base}/{fid.replace('?', '.html?') if '?' in fid else fid + '.html'}")
+            t0 = time.monotonic()
+            res = run_form(page, source, timeout_ms=5000)
+            secs = round(time.monotonic() - t0, 2)
+            state = page.evaluate("() => window.__state || {}")
+            fields = {}
+            keys = set(spec["expected"]) | {k for k, l in LABEL.items() if any(l in i.plan.question.lower() for i in res.items)}
+            for key in sorted(keys):
+                item = next((i for i in res.items if LABEL[key] in i.plan.question.lower()), None)
+                exp = spec["expected"].get(key)
+                fields[key] = {"expected": exp, "present": item is not None,
+                               "fill_ok": bool(item and item.filled), "dom_readback": bool(item and item.verified),
+                               "app_state": (state.get(key) == exp) if exp is not None else None,
+                               "conditional": key in spec.get("conditional", []),
+                               "detail": (item.detail if item else "")[:160]}
+            rows.append({"fixture": fid, "desc": spec["desc"], "seconds": secs, "app_state": state, "fields": fields})
+            ctx.close()
+        b.close()
+    import formfill
+    diff = _git("diff", "HEAD", "--", "formfill") + "\n".join(
+        f"{u}:{sha(ROOT / u)}" for u in _git("ls-files", "--others", "--exclude-standard", "--", "formfill").splitlines())
+    prov = {"pipeline_module": str(Path(formfill.__file__).parent), "evaluated_commit": _git("rev-parse", "HEAD"),
+            "pipeline_diff_sha256": hashlib.sha256(diff.encode()).hexdigest() if diff.strip() else None,
+            "ground_truth_3d_sha256": sha(BENCH / "ground_truth_3d.json"), "tool_sha256": sha(Path(__file__)),
+            "fixtures_sha256": {f.name: sha(f) for f in sorted((BENCH / "fixtures").glob("w3d_*.html"))}}
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+    (args.out_dir / "widget_results.json").write_text(json.dumps({"provenance": prov, "results": rows}, indent=2) + "\n")
+    tot = {m: sum(1 for r in rows for f in r["fields"].values() if f["expected"] is not None and f[m]) for m in ("fill_ok", "dom_readback", "app_state")}
+    n = sum(1 for r in rows for f in r["fields"].values() if f["expected"] is not None)
+    cond = [f for r in rows for f in r["fields"].values() if f["conditional"]]
+    print(f"{n} expected fields: fill_ok {tot['fill_ok']}, dom_readback {tot['dom_readback']}, app_state {tot['app_state']}; "
+          f"conditional discovered+filled {sum(f['fill_ok'] for f in cond)}/{len(cond)}")
+    for r in rows:
+        print(f"  {r['fixture']:38} {r['seconds']:5}s", {k: (f['fill_ok'], f['dom_readback'], f['app_state']) for k, f in r['fields'].items()})
+
+
+if __name__ == "__main__":
+    main()
